{
  "entry": "main.py",
  "watchInclude": [
    "**/*"
  ],
  "watchExclude": [
    "**/.git/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.pygame-preview-runtime/**",
    "**/logs/**",
    "**/log/**",
    "**/*.log",
    "**/*.tmp",
    "**/*.temp",
    "**/*.pid",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/.coverage"
  ],
  "softReloadEnabled": true,
  "softReloadInclude": [
    "**/*.json",
    "**/*.toml",
    "**/*.ini",
    "**/*.yaml",
    "**/*.yml",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.bmp",
    "**/*.webp",
    "**/*.gif",
    "**/*.wav",
    "**/*.ogg",
    "**/*.mp3",
    "**/*.ttf",
    "**/*.otf",
    "**/*.txt"
  ],
  "softReloadExclude": [
    "**/*.py"
  ],
  "reloadDebounceMs": 300,
  "autoStart": false,
  "debugPanelDefault": true,
  "previewPanelDefault": true,
  "previewFrameIntervalMs": 120,
  "previewMaxWidth": 1920,
  "previewInputEnabled": true,
  "panelOnlyMode": false,
  "panelOnlyStrict": false,
  "previewTransport": "hybrid",
  "sourceRoots": [
    "src",
    "lib",
    "packages/*/src",
    "apps/*/src",
    "services/*/src"
  ],
  "gamepadPreset": "generic",
  "audioInitMode": "auto",
  "audioDefaultMuted": false,
  "audioDefaultVolume": 1,
  "checkpointOnReload": false,
  "performanceMode": true,
  "previewBandwidthKbps": 8192,
  "previewCompressionMinBytes": 8192,
  "previewSocketChunkBytes": 262144,
  "previewDeltaRectsMax": 24,
  "inspectorAutoRefreshMs": 1200,
  "telemetryOptIn": false,
  "lowLatencyMode": false,
  "inputDeterministic": false,
  "inputDeterministicStepMs": 16,
  "qualityPreset": "quality",
  "startupGuardMaxRestarts": 3,
  "startupGuardWindowMs": 8000,
  "reloadBurstMax": 6,
  "reloadBurstWindowMs": 8000,
  "reloadMinimumIntervalMs": 250,
  "dependencyPromptCooldownMs": 180000,
  "dependencyPromptMuteAfterInstallMs": 45000,
  "surfaceMode": "mirror",
  "reloadMode": "restart"
}
